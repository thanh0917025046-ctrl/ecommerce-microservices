    {
      "name": "04 Order & Kafka",
      "item": [
        {
          "name": "TC-ORD-04 + TC-ORD-05 Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}",
                "type": "text"
