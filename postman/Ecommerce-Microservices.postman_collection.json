    {
      "name": "02 Customer & Membership",
      "item": [
        {
          "name": "Set Member GOLD (mid=3)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{memberUid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "{{memberUid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Demo Member\",\n  \"mid\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-CUS-04 Get Membership",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{memberUid}}/membership",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "{{memberUid}}",
                "membership"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); pm.test(\"GOLD score=500\", () => { pm.expect(j.membership.mname).to.eql(\"GOLD\"); pm.expect(j.membership.score).to.eql(500); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-CUS-05 Get Customer WITHOUT token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{memberUid}}",
              "host": [
                "{{baseUrl}}"
