            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"pid\": 1,\n      \"qty\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json(); pm.collectionVariables.set(\"oid\", j.oid); pm.test(\"Discount = 10\", () => pm.expect(j.discount).to.eql(10));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Created Order",
